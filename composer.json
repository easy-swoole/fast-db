{
    "name": "easyswoole/fast-db",
    "type": "library",
    "description": "php stander lib",
    "keywords": [
        "swoole",
        "framework",
        "async",
        "easyswoole"
    ],
    "homepage": "https://www.easyswoole.com/",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "YF",
            "email": "291323003@qq.com"
        }
    ],
    "require": {
        "ext-swoole": ">=5.1",
        "php": ">=8.1",
        "easyswoole/mysqli": "^5.0.8",
        "easyswoole/pool": "^3.0.6",
        "easyswoole/spl": "^2.1"
    },
    "require-dev": {
        "ext-mysqli": "*",
        "easyswoole/swoole-ide-helper": "^1.0",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "EasySwoole\\FastDb\\": "src/",
            "EasySwoole\\FastDb\\Tests\\": "tests/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasySwoole\\FastDb\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php",
        "test:unit": "@php tests/run.php --testsuite unit",
        "test:integration": "@php tests/run.php --testsuite integration"
    }
}
